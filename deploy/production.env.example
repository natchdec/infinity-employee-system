# Infinity Employee System - production readiness template
# Example values only. Confirm the final DNS name and provision real credentials outside source control.

APP_ENV=production
APP_ORIGIN=https://employee.infinitysolutions.co.th
APP_BIND_IP=0.0.0.0
APP_PORT=3000

DB_OWNER_PASSWORD=replace-with-url-safe-random-value
DB_APP_PASSWORD=replace-with-url-safe-random-value

ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_AUTH=replace-with-secure-reference-or-runtime-value

STORAGE_DRIVER=s3
STORAGE_BUCKET=replace-with-private-bucket
STORAGE_REGION=replace-with-region
STORAGE_ENDPOINT=https://replace-with-s3-compatible-endpoint
STORAGE_FORCE_PATH_STYLE=false

PROJECT_MASTER_TENANT_ID=00000000-0000-0000-0000-000000000000
PROJECT_MASTER_CLIENT_ID=00000000-0000-0000-0000-000000000000
PROJECT_MASTER_CLIENT_AUTH=replace-with-secure-reference-or-runtime-value
PROJECT_MASTER_SITE_ID=replace-with-graph-site-id
PROJECT_MASTER_LIST_ID=replace-with-graph-list-id
PROJECT_MASTER_COLUMN_MAP={"code":"ProjectCode","name":"ProjectName","status":"Status","activeValues":["Active"]}

GOOGLE_ROUTES_API_KEY=replace-with-restricted-server-key
GOOGLE_ROUTES_RETENTION_CONFIRMED=false
