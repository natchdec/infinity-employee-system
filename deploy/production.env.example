# Infinity Employee System - production readiness template
# Example values only. Keep real runtime files only on the deployment VM with mode 0600.

APP_ENV=production
APP_ORIGIN=https://employee.infinitysolutions.co.th
APP_BIND_IP=127.0.0.1
APP_PORT=3000

DB_OWNER_PASSWORD=[REDACTED]
DB_APP_PASSWORD=[REDACTED]

# Production identity is Cloudflare Access in front of the private origin.
# Microsoft Entra ID is configured as the Cloudflare Access identity provider.
AUTH_MODE=cloudflare_access
CLOUDFLARE_ACCESS_TEAM_DOMAIN=steep-scene-b973.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-access-application-aud

# Approval/status email notifications use Microsoft Graph Mail.Send with the existing app-only certificate identity.
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATION_SENDER=hr@infinitysolutions.co.th

# Optional direct/UAT Entra OIDC fallback only; not required by cloudflare_access mode.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_AUTH_MODE=certificate
# ENTRA_CLIENT_PRIVATE_KEY_PATH=/run/secrets/entra/client.key
# ENTRA_CLIENT_CERT_PATH=/run/secrets/entra/client.crt

# Production documents use private ESXi-local filesystem storage.
STORAGE_DRIVER=filesystem
STORAGE_ROOT=/data/documents
DOCUMENTS_HOST_PATH=/srv/infinity-employee/documents

# Runtime file contains the Google Routes API credential and must not be committed.
# Standard Google Maps Platform terms are used in transient/no-store preview mode.
# Keep durable distance/duration retention disabled unless a separately documented license permits it.
GOOGLE_ROUTES_ENV_FILE=/etc/infinity-employee/google-routes.env
GOOGLE_ROUTES_RETENTION_CONFIRMED=false
# Set true only after a live production probe confirms Places API (New) is enabled.
GOOGLE_PLACES_ENABLED_CONFIRMED=false
# Application-enforced monthly request caps. Keep below the current 10,000 free monthly usage cap per SKU.
GOOGLE_PLACES_MONTHLY_HARD_CAP=8500
GOOGLE_ROUTES_MONTHLY_HARD_CAP=8500
GOOGLE_MAPS_STATIC_MONTHLY_HARD_CAP=8500

# Project Master is active production scope.
# Source verified 2026-09-30: Microsoft Lists / SharePoint Sales Pipeline.
# Keep the client credential only in the runtime secret store. Engineer Lead and Cost Center
# are intentionally omitted until authoritative source fields exist.
PROJECT_MASTER_TENANT_ID=1e85b452-905e-4ec2-805a-39cf81ea8d95
PROJECT_MASTER_CLIENT_ID=replace-with-project-master-app-client-id
PROJECT_MASTER_CLIENT_AUTH=replace-at-runtime
PROJECT_MASTER_SITE_ID=infinitysolutionservice.sharepoint.com,fc1d5bea-a498-4677-a112-24e355ac9074,d7875f7c-f683-4e00-96a8-a85601bcf2a0
PROJECT_MASTER_LIST_ID=c1c2ff83-62fd-42e7-a98f-3bf9566e1d77
PROJECT_MASTER_COLUMN_MAP={"code":"Title","name":"ProjectName","customer":{"lookupIdField":"CustomerLookupId","listId":"bac6a1d2-84fe-4806-95a1-bcb4b66bdb06","valueField":"CompanyShortName"},"salesOwner":{"lookupIdField":"SaleNameLookupId","listId":"07de377c-c069-40aa-afcf-fc90191b17c6","valueField":"InfinityContactShortName"},"startDate":"ProductStartDate","endDate":"ProductEndDate","poNumber":"PONumber","poDate":"PODate","poCreateDate":"POCreateDate","status":"Status","activeValues":["Lead","Quotation","Bidding","Win","Lose"]}

# Easy-ACC and Smartbiz remain deferred for the current cut and do not block core readiness.

# Set only after receipt-backed review.
PRODUCTION_RESTORE_ACCEPTED=false
PRODUCTION_CUTOVER_APPROVED=false
