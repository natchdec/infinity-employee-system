# Infinity Employee System - ESXi UAT
# Use URL-safe random values. Keep the real .env only on the deployment VM.
APP_ORIGIN=https://172.20.11.220
APP_BIND_IP=127.0.0.1
APP_PORT=3000
ENTRA_TENANT_ID=replace-with-infinity-tenant-id
ENTRA_CLIENT_ID=replace-with-employee-system-client-id
ENTRA_CLIENT_AUTH_MODE=certificate
ENTRA_CLIENT_PRIVATE_KEY_PATH=/run/secrets/entra/client.key
ENTRA_CLIENT_CERT_PATH=/run/secrets/entra/client.crt
# ENTRA_CLIENT_AUTH is only required when ENTRA_CLIENT_AUTH_MODE=secret
DB_OWNER_PASSWORD=replace-with-url-safe-random-secret
DB_APP_PASSWORD=replace-with-url-safe-random-secret
